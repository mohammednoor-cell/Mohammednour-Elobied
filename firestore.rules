rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Health check / connection test doc
    match /test/{docId} {
      allow read: if isSignedIn() && isValidId(docId);
    }

    // User data paths
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      match /profile/{profileId} {
        allow read, write: if isOwner(userId) && isValidId(profileId);
      }

      match /projects/{projectId} {
        allow read, write: if isOwner(userId) && isValidId(projectId);
      }

      match /notes/{noteId} {
        allow read, write: if isOwner(userId) && isValidId(noteId);
      }
    }
  }
}
